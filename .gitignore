dist/
vendor/
.agents/
/AGENTS.md

# tests/ gained an importable module with tests/wire.py - the packet-size model
# both halves of the suite measure against - and importing it leaves bytecode
# beside it. Everything else here is a script that is run rather than imported,
# so this had nothing to ignore until now. panel/.gitignore says the same for
# its own tree.
__pycache__/
*.pyc

# And the cache the root ruff run leaves. ruff writes its own .gitignore inside
# it, so git was never going to show it - this is here so the directory is
# listed where somebody looks for it, beside the panel tree's own entry.
.ruff_cache/
