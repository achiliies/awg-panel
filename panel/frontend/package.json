{
  "name": "awg-panel-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "AWG Panel single-page app (AmneziaWG server management UI)",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write --print-width 100 \"src/**/*.{ts,tsx,css}\" \"*.{ts,js,json,html}\"",
    "format:check": "prettier --check --print-width 100 \"src/**/*.{ts,tsx,css}\" \"*.{ts,js,json,html}\""
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-alert-dialog": "^1.1",
    "@radix-ui/react-dialog": "^1.1",
    "@radix-ui/react-dropdown-menu": "^2.1",
    "@radix-ui/react-label": "^2.1",
    "@radix-ui/react-popover": "^1.1",
    "@radix-ui/react-progress": "^1.1",
    "@radix-ui/react-select": "^2.1",
    "@radix-ui/react-separator": "^1.1",
    "@radix-ui/react-slot": "^1.1",
    "@radix-ui/react-switch": "^1.1",
    "@radix-ui/react-tabs": "^1.1",
    "@radix-ui/react-tooltip": "^1.1",
    "@tanstack/react-query": "^5.51",
    "class-variance-authority": "^0.7",
