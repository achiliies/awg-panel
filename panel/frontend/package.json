    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "eslint-plugin-react-refresh": "^0.4",
    "globals": "^15",
    "postcss": "^8.5.3",
    "prettier": "3.9.6",
    "tailwindcss": "^3.4",
    "tailwindcss-animate": "^1.0",
    "typescript": "^5.5",
    "typescript-eslint": "^8",
    "vite": "^6.4.3"
